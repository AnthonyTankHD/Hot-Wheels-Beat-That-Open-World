; Engine configuration file.
; Hot Wheels Beat That — Open World City
; Godot 4.3

config_version=5

[application]

config/name="Hot Wheels Beat That — Open World City"
run/main_scene="res://scenes/start_menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]

